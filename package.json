{
  "name": "sci-j-dmrc-profile",
  "version": "1.2.0",
  "private": true,
  "description": "SCI J application, unique login and DMRC student profiles",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:aero": "esbuild src/aero-shards-entry.jsx --bundle --format=iife --outfile=public/aero-shards.bundle.js --minify",
    "build:staggered": "esbuild src/staggered-text-entry.jsx --bundle --format=iife --outfile=public/staggered-text.bundle.js --minify",
    "build": "npm run build:staggered"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "esbuild": "^0.25.9"
  }
}
